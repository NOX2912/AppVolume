{
  "sourceLanguage": "en",
  "strings": {
    "App Volumes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Lautstärken"
          }
        }
      }
    },
    "AppVolume needs the “Screen & System Audio Recording → System Audio Recording Only” permission to change app volumes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AppVolume braucht die Berechtigung „Bildschirm- & Systemaudioaufnahme → Nur Systemaudio“, um Lautstärken zu ändern."
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Anmeldung starten"
          }
        }
      }
    },
    "Mute": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stumm schalten"
          }
        }
      }
    },
    "No app is playing audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App gibt gerade Audio aus."
          }
        }
      }
    },
    "No output device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ausgabegerät"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen öffnen"
          }
        }
      }
    },
    "Please allow AppVolume in System Settings → Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte AppVolume in den Systemeinstellungen → Anmeldeobjekte erlauben."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "System audio access required": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Systemaudio fehlt"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannt"
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stummschaltung aufheben"
          }
        }
      }
    }
  },
  "version": "1.0"
}
